# CWA — server-side only, never prefix with VITE_
CWA_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543). Migrations derive the session pooler (5432) from it.
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=weather-data

# Internal jobs — openssl rand -hex 32
INGESTION_SECRET=
# Production origin the Supabase cron job calls, e.g. https://your-app.vercel.app. Copied to Vault by `task cron:secrets`.
API_BASE_URL=
